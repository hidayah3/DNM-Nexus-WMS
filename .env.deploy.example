# Copy this to .env on the WMS server. Never commit the filled-in file.
WMS_DOMAIN=wms.dnmnexus.com
POSTGRES_DB=wms
POSTGRES_USER=wms
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_ALPHANUMERIC_SECRET
SMS_WMS_INGEST_TOKEN=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
SMS_SHIPMENT_UPDATE_URL=https://your-sms-api-host/api/integrations/wms/shipment-updates
SMS_SHIPMENT_UPDATE_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET_SHARED_WITH_SMS
SMS_INVENTORY_SYNC_URL=https://your-sms-api-host/api/integrations/wms/inventory-updates
SMS_INVENTORY_SYNC_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET_SHARED_WITH_SMS
# K-Link order API the WMS pulls paid orders from. Authorization is the full header value.
ORDER_SYNC_URL=https://REPLACE_WITH_K_LINK_PRODUCTION_HOST/api/v1/webhook/wms/order/sync
ORDER_SYNC_AUTHORIZATION=Basic REPLACE_WITH_BASE64_OF_USERNAME_COLON_PASSWORD
ORDER_SYNC_INTERVAL=5m
ORDER_SYNC_IMPORT_STATUSES=PAID
ORDER_SYNC_STOCKIST=WHMY
WMS_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODING_OF_32_RANDOM_BYTES
EASYPARCEL_CLIENT_ID=
EASYPARCEL_CLIENT_SECRET=
EASYPARCEL_ENVIRONMENT=sandbox
EASYPARCEL_WEBHOOK_TOKEN=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET
# Optional fallback only; the order screen requests real EasyParcel rates per order.
VITE_WMS_COURIERS=[]
VITE_WMS_API_ENABLED=true
VITE_WMS_READ_ONLY_PREVIEW=false # Staff sign in on the WMS sign-in page; one account per person
VITE_WMS_EASYPARCEL_CONNECT=true # Shows the OAuth connect link after server credentials are configured

# Warehouse sender address put on every new synced order (fill in before the first order arrives).
# Leave WAREHOUSE_SENDER_ADDRESS_1 empty to copy the sender from the most recent order instead.
WAREHOUSE_SENDER_NAME=
WAREHOUSE_SENDER_PHONE_COUNTRY=60
WAREHOUSE_SENDER_PHONE=
WAREHOUSE_SENDER_EMAIL=
WAREHOUSE_SENDER_ADDRESS_1=
WAREHOUSE_SENDER_ADDRESS_2=
WAREHOUSE_SENDER_POSTCODE=
WAREHOUSE_SENDER_CITY=
# EasyParcel state code, e.g. SGR, KUL, JHR
WAREHOUSE_SENDER_STATE=

EASYPARCEL_API_VERSION=2026-09
