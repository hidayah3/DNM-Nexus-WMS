# Local API configuration template. Replace placeholders via your secret manager.
WMS_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://user:password@host:5432/database
WMS_ALLOWED_ORIGINS=https://your-wms-frontend-host
SMS_WMS_INGEST_TOKEN=generate-a-long-random-server-to-server-secret
SMS_SHIPMENT_UPDATE_URL=https://your-sms-api-host/api/integrations/wms/shipment-updates
SMS_SHIPMENT_UPDATE_TOKEN=generate-a-long-random-secret-shared-with-sms
SMS_INVENTORY_SYNC_URL=https://your-sms-api-host/api/integrations/wms/inventory-updates
SMS_INVENTORY_SYNC_TOKEN=generate-a-long-random-secret-shared-with-sms
# Order API the WMS pulls orders from (POST). Authorization is the full header value.
ORDER_SYNC_URL=https://dcmy-api-dev-v2.k-link.us/api/v1/webhook/wms/order/sync
ORDER_SYNC_AUTHORIZATION=Basic replace-with-the-key-from-postman
ORDER_SYNC_INTERVAL=5m
ORDER_SYNC_IMPORT_STATUSES=PAID
ORDER_SYNC_STOCKIST=WHMY
EASYPARCEL_CLIENT_ID=
EASYPARCEL_CLIENT_SECRET=
EASYPARCEL_ENVIRONMENT=sandbox
EASYPARCEL_REDIRECT_URI=https://your-wms-api-host/api/easyparcel/callback
EASYPARCEL_WEBHOOK_TOKEN=generate-64-hex-characters-and-register-the-webhook-url
WMS_TOKEN_ENCRYPTION_KEY=
EASYPARCEL_COOKIE_SECURE=true
EASYPARCEL_API_VERSION=2026-09
